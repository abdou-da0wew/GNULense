{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@core/*": [
        "./core/*"
      ],
      "@flows/*": [
        "./flows/*"
      ],
      "@mergers/*": [
        "./mergers/*"
      ],
      "@scopes/*": [
        "./scopes/*"
      ]
    },
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "scopes/**/*",
    "mergers/**/*",
    "flows/**/*",
    "strappers/**/*",
    "core/**/*"
  ]
}
