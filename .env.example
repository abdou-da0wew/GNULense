# 0$ infra — fill only what you have, all optional for local dev
NODE_ENV=development
PORT=3000

# Tigris S3 (10GB) — HTML/JSON only, NOT media
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_REGION=auto
TIGRIS_BUCKET=gnulense-store
TIGRIS_ACCESS_KEY=
TIGRIS_SECRET_KEY=

# MongoDB Atlas M0 (512MB) — manifests + checkpoints
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gnulense

# GitHub CDN — media only (images/videos/pdfs > small)
GITHUB_TOKEN=ghp_xxx
GITHUB_MEDIA_REPO=abdou-da0wew/GNULense-media
GITHUB_MEDIA_BRANCH=main

# Vercel Edge — backend
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...
VERCEL_REVALIDATE_SECRET=change-me

# Crawler shard (colab sets these)
CRAWL_SHARD_ID=0
CRAWL_SHARD_TOTAL=5

# Optional Railway backend (leave empty to run pure Edge)
RAILWAY_BACKEND_URL=
